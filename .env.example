# Copy to .env and fill. Never commit the filled copy.

POLYGON_RPC_URL=https://polygon-rpc.com
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGONSCAN_API_KEY=

# Amoy testnet only. For mainnet use `--ledger` or a keystore; never a raw key.
DEPLOYER_PRIVATE_KEY=

# Deployment parameters
GOVERNANCE=       # Safe multisig. Must not be an EOA on mainnet.
GUARDIAN=         # Separate key, separate person, separate hardware.
TREASURY=
QUOTE_TOKEN=      # USDC. Defaults to Polygon PoS USDC.e if unset.
BOND_TOKEN=       # Builder bond token.
